# ---------------------------------------------------------------
# Backend de stockage : local (dev, aucun service) ou minio (S3)
# ---------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_LAKE_DIR=./data/lake

# --- MinIO (utilise seulement si STORAGE_BACKEND=minio) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
BUCKET_BRONZE=chab-bronze
BUCKET_SILVER=chab-silver
BUCKET_GOLD=chab-gold

# --- Donnees sources ---
LANDING_DIR=./data/landing
SNAPSHOT_S1=2026-01-01
SNAPSHOT_S2=2026-06-01

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
MLFLOW_EXPERIMENT=chab_appetence
MLFLOW_REGISTERED_MODEL=chab_appetence

# --- Modelisation ---
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
CHAMPION_METRIC=pr_auc
ARTIFACTS_DIR=./artifacts
